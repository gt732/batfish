/interface bridge add comment="LAN bridge" name=bridge-lan
/interface ethernet set [ find default-name=ether2 ] disable-running-check=no name=customer-a
/interface ethernet set [ find default-name=ether3 ] disable-running-check=no name=customer-b
/interface ethernet set [ find default-name=ether6 ] disable-running-check=no
/interface ethernet set [ find default-name=ether7 ] disable-running-check=no
/interface ethernet set [ find default-name=ether8 ] disable-running-check=no
/interface ethernet set [ find default-name=ether4 ] disable-running-check=no name=mgmt
/interface ethernet set [ find default-name=ether5 ] disable-running-check=no disabled=yes name=spare
/interface ethernet set [ find default-name=ether1 ] disable-running-check=no name=uplink-core
/interface vlan add interface=bridge-lan name=vlan25 vlan-id=25
/interface vlan add interface=ether6 name=vlan30 vlan-id=30
/interface wireless security-profiles set [ find default=yes ] supplicant-identity=MikroTik
/interface bridge port add bridge=bridge-lan interface=customer-a pvid=10
/interface bridge port add bridge=bridge-lan interface=customer-b pvid=20
/interface bridge vlan add bridge=bridge-lan vlan-ids=10,20 tagged=bridge-lan,uplink-core untagged=ether6,ether7
/interface bridge vlan add bridge=bridge-lan vlan-ids=10 tagged=bridge-lan,uplink-core untagged=customer-a
/interface bridge vlan add bridge=bridge-lan vlan-ids=20 tagged=bridge-lan,uplink-core untagged=customer-b
/ip address add address=10.0.0.2/30 comment="L3 to Cisco core" interface=uplink-core network=10.0.0.0
/ip address add address=192.168.10.1/24 comment="subscriber gateway" interface=bridge-lan network=192.168.10.0
/ip address add address=172.16.0.2/24 comment=management interface=mgmt network=172.16.0.0
/ip address add address=192.168.25.1/24 interface=vlan25 network=192.168.25.0
/ip dhcp-client add disabled=no interface=uplink-core
/ip dns set allow-remote-requests=yes servers=1.1.1.1,8.8.8.8
/ip firewall filter add action=accept chain=input comment="allow ping" protocol=icmp
/ip firewall filter add action=drop chain=input comment="drop unsolicited inbound" in-interface=uplink-core
/ip route add comment="default to core" distance=1 gateway=10.0.0.1
/ip route add comment="test static route" distance=10 dst-address=198.51.100.0/24 gateway=10.0.0.1
/system identity set name=mtik-edge-01
