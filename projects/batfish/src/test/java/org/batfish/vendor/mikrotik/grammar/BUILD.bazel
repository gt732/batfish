load("@batfish//skylark:junit.bzl", "junit_tests")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

junit_tests(
    name = "tests",
    srcs = glob(["**/*Test.java"]),
    resources = [
        "//projects/batfish/src/test/resources:log4j_config",
        "//projects/batfish/src/test/resources/org/batfish/vendor/mikrotik/grammar/testconfigs",
    ],
    runtime_deps = [
        "@maven//:org_apache_logging_log4j_log4j_core",
        "@maven//:org_apache_logging_log4j_log4j_slf4j_impl",
    ],
    deps = [
        "//projects/batfish",
        "//projects/batfish/src/test/java:batfish_testlib",
        "//projects/batfish/src/main/antlr4/org/batfish/vendor/mikrotik/grammar",
        "//projects/batfish/src/main/java/org/batfish/vendor/mikrotik/grammar",
        "//projects/batfish/src/main/java/org/batfish/vendor/mikrotik/representation",
        "//projects/common",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_hamcrest_hamcrest",
    ],
)
